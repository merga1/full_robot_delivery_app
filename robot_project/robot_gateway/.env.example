GATEWAY_BACKEND_URL=wss://restaurant.example.com/api/v1/robot-gateway
GATEWAY_ROBOT_ID=robot_01
GATEWAY_ROBOT_TOKEN=replace-with-robot-gateway-token
GATEWAY_VERSION=1.0.0
GATEWAY_ROS_DISTRO=humble
GATEWAY_NAV_ACTION=/navigate_to_pose
GATEWAY_HEARTBEAT_SECONDS=5
GATEWAY_RECONNECT_SECONDS=3
GATEWAY_DESTINATIONS_FILE=/opt/restaurant-robot-gateway/config/destinations.json
GATEWAY_ALLOW_SIM=0
GATEWAY_HOME_DESTINATION=home
GATEWAY_TTS_BINARY=espeak-ng
