# Copy to real1_link.env:   cp real1_link.env.example real1_link.env
# Values containing spaces MUST be quoted (this file is also `source`d by bash).

# ── Workspaces ────────────────────────────────────────────────────────────────
REAL1_ROS_SETUP=/opt/ros/humble/setup.bash
# Optional extra workspace sourced BEFORE REAL1_WS (e.g. l2jd_ws):
REAL1_EXTRA_SETUP=/home/delv/l2jd_ws/install/setup.bash
REAL1_WS=/home/delv/articubot_one1

# ── Robot stack ───────────────────────────────────────────────────────────────
REAL1_START_CMD="ros2 launch articubot_one master.launch.py"
# none (default) | restart_launch | script
REAL1_ENABLE_MOTORS_MODE=none
# REAL1_ENABLE_MOTORS_CMD="ros2 service call /some/enable std_srvs/srv/Trigger"

# Nodes that must be visible for the stack to count as "up" (comma separated)
ROBOT_EXPECTED_NODES=controller_manager,amcl,bt_navigator,map_server
# Seconds after START before the app treats the stack as running even if a node is missing
ROBOT_LAUNCH_GRACE_S=45

# ── Drive / topics ────────────────────────────────────────────────────────────
REAL1_CMD_VEL_TOPIC=/cmd_vel
REAL1_CMD_VEL_LINEAR_SCALE=1.0
REAL1_CMD_VEL_ANGULAR_SCALE=1.0
ROBOT_MAX_LINEAR=0.6
ROBOT_MAX_ANGULAR=1.5
ROBOT_TELEOP_STALE_S=0.5

# ── Navigation ────────────────────────────────────────────────────────────────
ROBOT_NAV_ACTION=navigate_to_pose
ROBOT_AMCL_TOPIC=/amcl_pose
ROBOT_INITIALPOSE_TOPIC=/initialpose
# Refuse goals until the robot has a pose estimate (set it in the app first)
ROBOT_REQUIRE_LOCALIZED=1
ROBOT_NAV_TIMEOUT_S=300
ROBOT_MISSION_DWELL_S=0
# Only used when Nav2's /map is not available (the app prefers the live map):
# ROBOT_MAP_YAML=/home/delv/articubot_one1/src/articubot_one/maps/my_map.yaml

# ── Battery (optional sensor_msgs/BatteryState topic; otherwise the app shows N/A)
# ROBOT_BATTERY_TOPIC=/battery_state

# ── Security — CHANGE THESE ───────────────────────────────────────────────────
ROBOT_ADMIN_USER=admin
ROBOT_ADMIN_PASS=change-me-admin
ROBOT_USER_USER=user
ROBOT_USER_PASS=change-me-user
# The kitchen dashboard (web) logs in with this account: it may manage the
# orders, the menu and the tables — but it must not drive the robot.
ROBOT_KITCHEN_USER=kitchen
ROBOT_KITCHEN_PASS=change-me-kitchen
ROBOT_JWT_SECRET=replace-with-a-long-random-string
ROBOT_TOKEN_TTL_HOURS=12

# ── Server ────────────────────────────────────────────────────────────────────
ROBOT_API_PORT=8000
# The address customers use to open the order page (the table QR points here).
# Leave it empty to use the address of the request that asks for the QR code.
# ROBOT_PUBLIC_HOST=http://192.168.1.50:8000
# Development without a robot / ROS (fake robot): 
# ROBOT_ALLOW_SIM=1
