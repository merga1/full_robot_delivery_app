[Unit]
Description=Robot controller API (FastAPI + ROS 2 hub)
# Start after networking and the discovery beacon are available.
After=network-online.target robot-beacon.service
Wants=network-online.target robot-beacon.service

[Service]
Type=simple
User=@USER@
Environment=HOME=@HOME@
Environment=ROBOT_ENV_FILE=@APP_DIR@/real1_link.env
WorkingDirectory=@APP_DIR@
ExecStart=/bin/bash @APP_DIR@/run_server_ros.sh
Restart=always
RestartSec=5
# On stop the API shuts the ROS stack down gracefully (up to ~26 s)
TimeoutStopSec=40
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
