APP_ENV=development
APP_NAME=Smart Restaurant Robot API
LOG_LEVEL=INFO

# PostgreSQL is the authoritative multi-client store.
DATABASE_URL=postgresql+asyncpg://app_user:change-me@postgres:5432/restaurant_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Generate a long random value before production deployment.
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:8000,http://localhost:5500,https://food-delivery-robot.netlify.app
PUBLIC_CUSTOMER_URL=http://localhost:8000/customer/

# Robot gateway and delivery policy.
ROBOT_GATEWAY_ENABLED=true
ROBOT_GATEWAY_HEARTBEAT_TIMEOUT_SECONDS=15
ROBOT_COMMAND_TTL_SECONDS=30
ROBOT_COMMAND_ACK_TIMEOUT_SECONDS=10
ROBOT_DEFAULT_HOME_DESTINATION=home
AUTO_RETURN_HOME=true
LOW_BATTERY_THRESHOLD_PERCENT=25
MIN_BATTERY_PERCENT_TO_DISPATCH=15
COLLECTION_CONFIRM_TIMEOUT_SECONDS=900
ARRIVAL_POSE_TOLERANCE_M=0.60

# Robot touchscreen uses a dedicated token, never a staff token.
ROBOT_SCREEN_TOKEN=replace-with-a-dedicated-screen-token

# Notifications. Leave FCM values empty to use the console/no-op provider.
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
NOTIFICATION_SOUND_ENABLED=true
OUTBOX_POLL_INTERVAL_SECONDS=1.0

# Pricing and optional development seed accounts.
TAX_RATE=0.0
DELIVERY_FEE=0.0
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_KITCHEN_USERNAME=kitchen
SEED_KITCHEN_PASSWORD=kitchen123
SEED_COURIER_USERNAME=courier
SEED_COURIER_PASSWORD=courier123

